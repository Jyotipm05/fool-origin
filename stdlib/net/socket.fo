module std::net;
#import @std:core;

pub class TcpSocket {
    pub fd: i32;
    pub connected: bool;

    pub fn open() -> TcpSocket;
    pub fn connect(this &self, ip: StringView, port: u16) -> bool;
    pub fn send(this &self, data: const& Span<u8>) -> isize;
    pub fn receive(this &self, buffer: &Span<u8>) -> isize;
    pub fn close(this &self);
}
