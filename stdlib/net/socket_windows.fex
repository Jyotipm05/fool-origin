module std::net::ffi;

@target(os = "windows")
@extern("C", link_name = "socket")
fn sys_socket(domain: i32, type_: i32, proto: i32) -> i32;

@target(os = "windows")
@extern("C", link_name = "connect")
fn sys_connect(fd: i32, addr: const* u8, port: u16) -> i32;

@target(os = "windows")
@extern("C", link_name = "send")
fn sys_send(fd: i32, buf: const* u8, len: usize) -> isize;

@target(os = "windows")
@extern("C", link_name = "recv")
fn sys_recv(fd: i32, buf: *u8, len: usize) -> isize;

@target(os = "windows")
@extern("C", link_name = "closesocket")
fn sys_close(fd: i32) -> i32;
