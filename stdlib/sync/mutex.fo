module std::sync;
#import @std:core;

pub ruleset Lockable<T> {
    fn lock(this &self);
    fn unlock(this &self);
}

pub class Mutex<T> {
    pub state: Atomic<u32>;
    pub data: T;

    pub fn create(value: T) -> Mutex<T>;
    pub fn lock(this &self) -> MutexGuard<T>;
    pub fn unlock(this &self);
}

pub class MutexGuard<T> {
    pub lock_ref: &Mutex<T>;

    pub fn get(this const& self) -> const& T;
    pub fn get_mut(this &self) -> &T;
    pub fn release(this self);
}
