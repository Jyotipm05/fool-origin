module std::math;
#import std::math::simd_ffi;

// Vectorized SIMD specialized branch monomorphization
fn Math<SIMD = true>::dot_product(a: const*f32, b: const* f32, length: usize) -> f32 {
    // Vectorized chunks (4-lane / 8-lane) via compiler vector intrinsics
    return simd_ffi::vec_dot(a, b, length);
}

fn Math<SIMD = true>::add_scalar(data: *f32, length: usize, scalar: f32) {
    simd_ffi::vec_add(data, length, scalar);
}
