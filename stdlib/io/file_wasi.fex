module std::io::wasi_ffi;

@target(os = "wasi")
@extern("wasi_snapshot_preview1", link_name = "fd_write")
fn wasi_fd_write(fd: i32, iovs: const*void, iovs_len: usize, nwritten:*usize) -> i32;

module std::io::sys_file;

struct CioVec {
    buf: const* u8;
    buf_len: usize;
}

@target(os = "wasi")
fn stdout_write(buf: const*u8, len: usize) {
    var iov = CioVec { buf: buf, buf_len: len };
    var written: usize = 0;
    wasi_ffi::wasi_fd_write(1, &iov as const* void, 1, &written);
}
