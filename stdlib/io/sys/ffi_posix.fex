module std::io::posix_ffi;

@target(os = "posix")
@extern("C", link_name = "open")
pub fn c_open(path: const* u8, flags: i32, mode: i32) -> i32;

@target(os = "posix")
@extern("C", link_name = "read")
pub fn c_read(fd: i32, buf: *u8, count: usize) -> isize;

@target(os = "posix")
@extern("C", link_name = "write")
pub fn c_write(fd: i32, buf: const* u8, count: usize) -> isize;

@target(os = "posix")
@extern("C", link_name = "close")
pub fn c_close(fd: i32) -> i32;
