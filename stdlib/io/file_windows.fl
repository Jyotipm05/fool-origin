module std::io;
#import std::io::win32_ffi;

fn File::open(path: StringView, mode: FileMode) -> File {
    var access = 0x80000000; // GENERIC_READ
    var creation = 3;        // OPEN_EXISTING
    if mode == FileMode::Write {
        access = 0x40000000; // GENERIC_WRITE
        creation = 2;        // CREATE_ALWAYS
    }
    var h = win32_ffi::CreateFileA(path.bytes, access, 0, 0 as *void, creation, 128, 0 as*void);
    return File { handle: h as i64, is_open: (h as i64 != -1) };
}

fn File::read(this &self, buffer: &Span<u8>) -> isize {
    if !self.is_open { return -1; }
    var read_bytes: u32 = 0;
    win32_ffi::ReadFile(self.handle as *void, buffer.ptr, buffer.length as u32, &read_bytes, 0 as*void);
    return read_bytes as isize;
}

fn File::write(this &self, data: const& Span<u8>) -> isize {
    if !self.is_open { return -1; }
    var written: u32 = 0;
    win32_ffi::WriteFile(self.handle as *void, data.ptr, data.length as u32, &written, 0 as*void);
    return written as isize;
}

fn File::close(this &self) {
    if self.is_open {
        win32_ffi::CloseHandle(self.handle as *void);
        self.is_open = false;
    }
}
