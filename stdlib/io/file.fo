module std::io;
#import @std:core;

pub enum FileMode {
    Read,
    Write,
    Append,
}

pub class File {
    pub handle: i64;
    pub is_open: bool;

    pub fn open(path: StringView, mode: FileMode = FileMode::Read) -> File;
    pub fn read(this &self, buffer: &Span<u8>) -> isize;
    pub fn write(this &self, data: const& Span<u8>) -> isize;
    pub fn close(this &self);
}
