module std::io;
#import @std:core;

pub ruleset Reader {
    fn read(this &self, buffer: &Span<u8>) -> isize;
}

pub ruleset Writer {
    fn write(this &self, data: const& Span<u8>) -> isize;
    fn flush(this &self);
}

pub class IO {
    pub fn print(msg: StringView);
    pub fn println(msg: StringView);
}
