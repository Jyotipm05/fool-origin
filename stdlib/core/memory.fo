module std::core;

pub class RawMemory {
    pub fn copy(dest: *u8, src: const* u8, bytes: usize);
    pub fn set(dest: *u8, value: u8, bytes: usize);
}

pub class ArenaAllocator {
    pub buffer: *u8;
    pub capacity: usize;
    pub offset: usize;

    pub fn create(capacity: usize) -> ArenaAllocator;
    pub fn allocate(this &self, bytes: usize, align: usize = 8) -> *u8;
    pub fn reset(this &self);
    pub fn destroy(this self);
}
