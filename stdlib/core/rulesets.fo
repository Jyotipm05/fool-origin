module std::core;

/// Nominal contract for types supporting equality comparisons
ruleset Equatable<T> {
    fn operator==(this const& self, other: const& T) -> bool;
    fn operator!=(this const& self, other: const& T) -> bool;
}

/// Nominal contract for ordering relations
ruleset Comparable<T: Equatable> {
    fn operator<(this const& self, other: const& T) -> bool;
    fn operator<=(this const& self, other: const& T) -> bool;
    fn operator>(this const& self, other: const& T) -> bool;
    fn operator>=(this const& self, other: const& T) -> bool;
}

/// Arithmetic capability bounds
ruleset Numeric<T> {
    fn operator+(this const& self, other: const& T) -> T;
    fn operator-(this const& self, other: const& T) -> T;
    fn operator*(this const& self, other: const& T) -> T;
    fn operator/(this const& self, other: const& T) -> T;
}

/// Custom cleanup hook for non-trivial types
ruleset Droppable {
    fn drop(this &self);
}

/// Custom heap or memory space allocator capability
ruleset Allocator {
    fn allocate(this &self, bytes: usize, alignment: usize) -> *u8;
    fn deallocate(this &self, ptr:*u8, bytes: usize, alignment: usize);
}
