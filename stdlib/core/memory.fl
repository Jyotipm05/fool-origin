module std::core;
#import std::core::sys_mem;

fn RawMemory::copy(dest: *u8, src: const* u8, bytes: usize) {
    for i in 0..bytes {
        dest[i] = src[i];
    }
}

fn RawMemory::set(dest: *u8, value: u8, bytes: usize) {
    for i in 0..bytes {
        dest[i] = value;
    }
}

fn ArenaAllocator::create(capacity: usize) -> ArenaAllocator {
    var raw = sys_mem::os_alloc_pages(capacity);
    return ArenaAllocator {
        buffer: raw,
        capacity: capacity,
        offset: 0,
    };
}

fn ArenaAllocator::allocate(this &self, bytes: usize, align: usize) -> *u8 {
    var aligned_offset = (self.offset + align - 1) & !(align - 1);
    if aligned_offset + bytes > self.capacity {
        return 0 as*u8; // Out of memory
    }
    var ptr = (self.buffer as usize + aligned_offset) as *u8;
    self.offset = aligned_offset + bytes;
    return ptr;
}

fn ArenaAllocator::reset(this &self) {
    self.offset = 0;
}

fn ArenaAllocator::destroy(this self) {
    if (self.buffer as usize) != 0 {
        sys_mem::os_free_pages(self.buffer, self.capacity);
        self.buffer = 0 as *u8;
    }
}
