module std::core;

pub enum MemoryOrder {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

pub class Atomic<T> {
    pub value: T;

    pub fn new(initial: T) -> Atomic<T>;
    pub fn load(this const& self, order: MemoryOrder = MemoryOrder::SeqCst) -> T;
    pub fn store(this &self, val: T, order: MemoryOrder = MemoryOrder::SeqCst);
    pub fn compare_exchange(this &self, expected: T, desired: T, order: MemoryOrder = MemoryOrder::SeqCst) -> bool;
    pub fn fetch_add(this &self, val: T, order: MemoryOrder = MemoryOrder::SeqCst) -> T;
    pub fn exchange(this &self, desired: T, order: MemoryOrder = MemoryOrder::SeqCst) -> T;
}
