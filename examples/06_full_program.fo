module examples::full_program;

#import @std:core;
#import @std:io;

pub constx MAX_ENTRIES: usize = 256;
pub constx DEFAULT_PORT: u16 = 8080;

pub class SessionManager {
    pub active_count: usize;
    pub is_running: bool;

    pub fn start(this &self) -> bool;
    pub fn get_active_sessions(this const& self) -> usize;
    pub fn stop(this self);
}

pub fn main() -> i32;

