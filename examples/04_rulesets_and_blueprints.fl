module examples::rulesets_and_blueprints;

// Point2D method implementations
fn Point2D::equals(this const& self, other: const& Point2D) -> bool {
    if (self.x != other.x) {
        return false;
    }
    if (self.y != other.y) {
        return false;
    }
    return true;
}

fn Point2D::translate(this &self, dx: f32, dy: f32) {
    self.x = self.x + dx;
    self.y = self.y + dy;
    return;
}

