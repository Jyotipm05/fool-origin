//
// examples/03_middle_defaults.fl
// Demonstrates Fool middle and trailing default parameters with named arguments.
//

module examples::middle_defaults;

// Fool allows default expressions in ANY parameter slot, including middle positions
async fn render_box(x: f32, y: f32, scale: f32 = 1, width: f32, height: f32, depth: f32 = 0) -> i32 {
    const area = width * height * scale;
    return 0;
}

fn configure_server(host: StringView, port: u16 = 8080, max_conns: usize = 1024, backlog: i32) -> bool {
    return true;
}

fn run_pipeline() {
    // Calling with positional arguments
    render_box(10, 20, 1, 100, 200, 0);

    // Calling with middle default preserved and named arguments disambiguating trailing slots
    render_box(10, 20, width: 100, height: 200);

    // Server configuration with middle default utilized
    configure_server("0.0.0.0", backlog: 128);

    return;
}

