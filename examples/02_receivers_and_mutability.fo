// Interface blueprint: classes, receiver declarations, and reference types.
//

module examples::receivers_and_mutability;

#import @std:core;

pub class ByteBuffer {
    pub data: *u8;
    pub capacity: usize;
    pub len: usize;

    pub fn length(this const& self) -> usize;
    pub fn append(this &self, byte: u8) -> bool;
    pub fn destroy(this self);
}

pub fn copy_memory(dst: *u8, src: const* u8, length: usize);
pub fn mutate_span(target: &Span<u8>, source: const& Span<u8>);

