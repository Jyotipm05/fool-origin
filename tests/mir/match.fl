// MIR: `match` becomes a `switch` on the variant; an arm that names payload values copies them out of the
// temporary holding the matched value (`_4.Rect.1` is the second payload value of `Rect`). Without `_`, the switch's
// else target is an `unreachable` block.
// Expected output: match.expected

module tests::hir::match_stmt;

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Empty,
}

enum Mode {
    Read,
    Write,
}

fn area(shape: Shape) -> f64 {
    match shape {
        Shape::Circle(r) => {
            return r * r * 3.0;
        }
        Shape::Rect(w, h) => {
            return w * h;
        }
        Shape::Empty => {
            return 0.0;
        }
    }
}

fn width(shape: Shape) -> f64 {
    var result = 0.0;
    match shape {
        Shape::Rect(w, _) => {
            result = w;
        }
        Shape::Circle => {
            result = 1.0;
        }
        _ => {}
    }
    return result;
}

fn code(mode: Mode) -> i32 {
    var out = 0;
    match mode {
        Mode::Read => { out = 1; }
        Mode::Write => { out = 2; }
    }
    return out;
}

fn nested(shape: Shape, mode: Mode) -> i32 {
    var total = 0;
    var i = 0;
    while (i < 3) {
        match mode {
            Mode::Read => {
                i = i + 1;
                continue;
            }
            _ => {
                match shape {
                    Shape::Circle(r) => { total = total + 1; }
                    _ => { total = total + 2; }
                }
            }
        }
        i = i + 1;
    }
    return total;
}

// A generic enum can be checked but not lowered yet.
enum Maybe<T> {
    Some(T),
    None,
}

fn unwrap_or_zero(m: Maybe<i32>) -> i32 {
    match m {
        Maybe::Some(v) => { return 1; }
        Maybe::None => { return 0; }
    }
}
