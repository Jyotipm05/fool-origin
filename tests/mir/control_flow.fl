// MIR: control flow becomes blocks and jumps. `if`, `while`, `for` (the step block is what `continue` jumps to),
// `break`, `continue`, early `return`, `&&` / `||` (a branch that writes a bool temporary).
// Expected output: control_flow.expected

module tests::mir::control_flow;

fn abs(x: i32) -> i32 {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn classify(x: i32) -> i32 {
    if (x < 0) {
        return -1;
    } else if (x == 0) {
        return 0;
    } else {
        return 1;
    }
}

fn countdown(n: i32) -> i32 {
    var total = 0;
    while (n > 0) {
        if (n == 3) {
            n = n - 1;
            continue;
        }
        if (n == 1) {
            break;
        }
        total = total + n;
        n = n - 1;
    }
    return total;
}

fn sum(data: const* f32, length: usize) -> f32 {
    var total: f32 = 0.0;
    for (var i: usize = 0; i < length; i = i + 1) {
        total = total + data[i];
    }
    return total;
}

fn skip_odd(n: i32) -> i32 {
    var total = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (i % 2 == 1) {
            continue;                       // lands on the step block, not on the condition
        }
        total = total + i;
    }
    return total;
}

fn forever() -> i32 {
    var count = 0;
    for (;;) {
        count = count + 1;
        if (count == 3) {
            break;
        }
    }
    return count;
}

fn in_range(x: i32, low: i32, high: i32) -> bool {
    return x >= low && x <= high;
}

fn either(a: bool, b: bool) -> bool {
    return a || b;
}

fn unit_function(flag: bool) {
    if (flag) {
        return;
    }
}
