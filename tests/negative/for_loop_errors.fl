// Checks on the parts of a `for` header.

module tests::negative::for_loop_errors;

fn bad(n: i32) -> i32 {
    var total = 0;
    for (var i = 0; i + 1; i = i + 1) { // expect-error: condition
        total = total + 1;
    }
    for (const j = 0; j < n; j = j + 1) { // expect-error: cannot assign
        total = total + j;
    }
    return total;
}
