// Shadowing is only allowed in a nested scope: redeclaring a name in the scope that already
// declares it (including a parameter at the top of the function body) is an error.
module tests::shadow_same_scope;

fn run(count: i32) -> i32 {
    var a = 1;
    // expect-error: redefinition of 'a'
    var a = 2;
    // expect-error: redefinition of 'count'
    var count = 3;
    {
        var a = 4;
        a = a + 1;
    }
    return a;
}
