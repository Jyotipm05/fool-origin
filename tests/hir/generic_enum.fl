/*
   HIR: every instance of a generic enum is an enum of its own, named by its type arguments (`Option<i32>`), listed once
   however often it is used. The type arguments come from the written type, from `Option<f64>::None`, from the type the
   context expects, or from the payload values (`Option::Some(5)` is an `Option<i32>`).
   Expected output: generic_enum.expected
*/

module tests::hir::generic_enum;

enum Option<T> {
    Some(T),
    None,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

fn first_positive(n: i32) -> Option<i32> {
    if (n > 0) {
        return Option::Some(n);
    }
    return Option::None;
}

fn nothing() -> Option<f64> {
    return Option<f64>::None;
}

fn unwrap_or(value: Option<i32>, fallback: i32) -> i32 {
    return match value {
        Option::Some(v) => v,
        Option::None => fallback,
    };
}

fn parse(n: i32) -> Result<i32, bool> {
    if (n < 0) {
        return Result::Err(true);
    }
    return Result::Ok(n);
}

fn code(result: Result<i32, bool>) -> i32 {
    match result {
        Result::Ok(v) => { return v; }
        Result::Err(failed) => { return 0; }
    }
}

fn wrap<T>(x: T) -> Option<T> {
    return Option::Some(x);
}

fn use_wrap() -> i32 {
    return unwrap_or(wrap(5), 0);
}
