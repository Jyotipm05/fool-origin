fn user(flag: bool, wide: i64, ratio: f32) -> i32 {
  let a#3: i32 = (call identity<i32> 3:i32);
  let b#4: i64 = (call identity<i64> wide#1);
  let c#5: i32 = (call identity<i32> 4:i32);
  let m#6: i32 = (call larger<i32> 1:i32 2:i32);
  let n#7: i64 = (call larger<i64> wide#1 3:i64);
  let r#8: f32 = (call larger<f32> ratio#2 2.0:f32);
  let boxed#9: Box<i32> = (new Box<i32> 4:i32);
  (call Box<i32>::put (addr boxed#9) 5:i32);
  let value#10: i32 = (call Box<i32>::get (convert:const& Box<i32> (addr boxed#9)));
  let wide_box#11: Box<i64> = (call Box<i64>::make 6:i64);
  let guessed#12: Box<i32> = (call Box<i32>::make 7:i32);
  let pair#13: Pair<i32, f32> = (new Pair<i32, f32> 1:i32 2.5:f32);
  let swapped#14: Pair<f32, i32> = (call Pair<i32, f32>::swap (convert:const& Pair<i32, f32> (addr pair#13)));
  let deep#15: Box<Box<bool>> = (call nested<bool> flag#0);
  let node#16: Link<i32> = (new Link<i32> 9:i32 null:Link<i32>?);
  let first#17: i32 = (call head<i32> (addr node#16));
  return (+ (+ (+ (+ a#3 c#5) m#6) value#10) first#17);
}

fn identity<i32>(x: i32) -> i32 {
  return x#0;
}

fn identity<i64>(x: i64) -> i64 {
  return x#0;
}

fn larger<i32>(a: i32, b: i32) -> i32 {
  if (> a#0 b#1) {
    return a#0;
  }
  return b#1;
}

fn larger<i64>(a: i64, b: i64) -> i64 {
  if (> a#0 b#1) {
    return a#0;
  }
  return b#1;
}

fn larger<f32>(a: f32, b: f32) -> f32 {
  if (> a#0 b#1) {
    return a#0;
  }
  return b#1;
}

fn Box<i32>::put(self: &Box<i32>, item: i32) {
  (= (field (deref self#0) .item) item#1);
}

fn Box<i32>::get(self: const& Box<i32>) -> i32 {
  return (field (deref self#0) .item);
}

fn Box<i64>::make(item: i64) -> Box<i64> {
  return (new Box<i64> item#0);
}

fn Box<i32>::make(item: i32) -> Box<i32> {
  return (new Box<i32> item#0);
}

fn Pair<i32, f32>::swap(self: const& Pair<i32, f32>) -> Pair<f32, i32> {
  return (new Pair<f32, i32> (field (deref self#0) .second) (field (deref self#0) .first));
}

fn nested<bool>(x: bool) -> Box<Box<bool>> {
  return (call Box<Box<bool>>::make (call Box<bool>::make x#0));
}

fn head<i32>(link: &Link<i32>) -> i32 {
  return (field (deref link#0) .value);
}

fn Box<bool>::make(item: bool) -> Box<bool> {
  return (new Box<bool> item#0);
}

fn Box<Box<bool>>::make(item: Box<bool>) -> Box<Box<bool>> {
  return (new Box<Box<bool>> item#0);
}
