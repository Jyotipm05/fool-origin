fn math::square(x: i32) -> i32 {
  return (* x#0 x#0);
}

fn math::clamp(x: i32) -> i32 {
  if (> x#0 ::math::LIMIT) {
    return ::math::LIMIT;
  }
  return (call math::square x#0);
}

fn math::deep::twice(x: i32) -> i32 {
  return (+ (call math::square x#0) (call math::square x#0));
}

fn run(a: i32) -> i32 {
  (= ::total (+ (+ (call math::clamp a#0) (call math::deep::twice a#0)) ::math::LIMIT));
  return ::total;
}
