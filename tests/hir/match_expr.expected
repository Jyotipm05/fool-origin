enum Shape { Circle(f64), Rect(f64, f64), Empty }
enum Mode { Read, Write }

fn area(shape: Shape) -> f64 {
  return (match shape#0 [Shape::Circle(r#1) => (* (* r#1 r#1) 3.0:f64)] [Shape::Rect(w#2, h#3) => (* w#2 h#3)] [Shape::Empty => 0.0:f64]);
}

fn code(mode: Mode) -> i32 {
  const c#1: i32 = (match mode#0 [Mode::Read => 1:i32] [_ => 2:i32]);
  return c#1;
}

fn widen(mode: Mode) -> i64 {
  const c#1: i64 = (match mode#0 [Mode::Read => 1:i64] [Mode::Write => 2:i64]);
  return c#1;
}

fn skip(shape: Shape) -> f64 {
  return (match shape#0 [Shape::Rect(w#1, _) => w#1] [_ => 0.0:f64]);
}
