// Calls are bound into canonical (declaration-order) slots: named arguments move into place and
// defaults, including middle defaults, are filled in. Expected output: canonical_slots.expected

module tests::calls::canonical_slots;

class Counter {
    value: i32;

    fn bump(this &self, by: i32 = 1, times: i32) -> i32;
    fn get(this const& self) -> i32;
}

fn Counter::bump(this &self, by: i32 = 1, times: i32) -> i32 {
    return times;
}

fn Counter::get(this const& self) -> i32 {
    return 0;
}

fn render_box(x: f32, y: f32, scale: f32 = 1, width: f32, height: f32, depth: f32 = 0) -> i32 {
    return 0;
}

fn configure(host: i32, port: i32 = 8080, backlog: i32) -> bool {
    return true;
}

fn nothing() {
    return;
}

fn caller() {
    var counter = Counter { value: 0 };
    render_box(10, 20, 1, 100, 200, 0);
    render_box(10, 20, width: 100, height: 200);
    render_box(height: 200, width: 100, y: 20, x: 10, depth: 3);
    configure(1, backlog: 128);
    configure(backlog: 2, host: 1, port: 3);
    nothing();
    counter.bump(times: 2);
    counter.bump(5, 6);
    counter.get();
    configure(configure(1, backlog: 2), backlog: 3);
    return;
}
