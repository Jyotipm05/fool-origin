{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fool",
  "scopeName": "source.fool",
  "fileTypes": [
    "fo",
    "fl",
    "fex"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#receivers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fool",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fool",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fool",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fool",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.fool",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.fool",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.import.fool",
          "match": "\\b#import\\b"
        },
        {
          "name": "keyword.control.directive.if.fool",
          "match": "@(if|elif|else)\\b"
        },
        {
          "name": "support.function.builtin.def.fool",
          "match": "\\bdef\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.attribute.fool",
          "match": "@(target|inline|align_as|extern)\\b"
        },
        {
          "name": "entity.name.function.attribute.fool",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fool",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.hex.fool",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.fool",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.fool",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.fool",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "receivers": {
      "patterns": [
        {
          "match": "\\b(this)\\s+(const&)\\s*([a-zA-Z_][a-zA-Z0-9_]*)?",
          "captures": {
            "1": { "name": "variable.language.this.fool" },
            "2": { "name": "storage.modifier.const.fool" },
            "3": { "name": "variable.parameter.self.fool" }
          }
        },
        {
          "match": "\\b(this)\\s+(&)\\s*([a-zA-Z_][a-zA-Z0-9_]*)?",
          "captures": {
            "1": { "name": "variable.language.this.fool" },
            "2": { "name": "keyword.operator.borrow.fool" },
            "3": { "name": "variable.parameter.self.fool" }
          }
        },
        {
          "match": "\\b(this)\\s+([a-zA-Z_][a-zA-Z0-9_]*)?",
          "captures": {
            "1": { "name": "variable.language.this.fool" },
            "2": { "name": "variable.parameter.self.fool" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.constx.fool",
          "match": "\\bconstx\\b"
        },
        {
          "name": "storage.modifier.const.fool",
          "match": "\\bconst\\b"
        },
        {
          "name": "storage.type.var.fool",
          "match": "\\bvar\\b"
        },
        {
          "name": "storage.type.declaration.fool",
          "match": "\\b(module|ruleset|blueprint|class|enum)\\b"
        },
        {
          "name": "keyword.declaration.function.fool",
          "match": "\\b(fn|async|await)\\b"
        },
        {
          "name": "keyword.control.flow.fool",
          "match": "\\b(return|if|else|for|in)\\b"
        },
        {
          "name": "storage.modifier.ref.fool",
          "match": "\\bref\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.numeric.fool",
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64)\\b"
        },
        {
          "name": "entity.name.type.primitive.fool",
          "match": "\\b(bool|void)\\b"
        },
        {
          "name": "support.type.stdlib.fool",
          "match": "\\b(StringView|Span|Atomic|Poll|Future|TaskHandle|Mutex|MutexGuard|Channel|TcpSocket|EventLoop)\\b"
        },
        {
          "name": "entity.name.type.custom.fool",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.fool" }
          }
        },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)::([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.type.class.fool" },
            "2": { "name": "entity.name.function.method.fool" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.mutable.fool",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.fool",
          "match": "->"
        },
        {
          "name": "keyword.operator.namespace.fool",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.fool",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.fool",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.reference.fool",
          "match": "(&|\\*)"
        },
        {
          "name": "keyword.operator.punctuation.fool",
          "match": "(:|;|\\,|\\.)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.fool",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}

